
# dotagent: derived MCP index — markdown is canonical (D-0027)
.agent/dotagent.db
.agent/dotagent.db-*

# dotagent: machine-local path stamp — must not be committed
.agent/.project-path

# dotagent: bootstrap interview packs are single-use INPUTS, not findings.
# They now write to $XDG_CACHE_HOME/dotagent/bootstrap/<project>/; this line
# catches any that predate that change or arrive from an older install.
# project-brief.md is the OUTPUT and stays tracked.
.agent/REPORTS/*-pack.md

# dotagent: the published operating canon. Cross-project working discipline,
# not documentation of this tool — it regenerates from the dotagent install,
# so it is local-only rather than part of what a user clones.
CLAUDE.md

# dotagent: tooling-sweep reports. These audit the dotagent engines, carry
# absolute machine paths, and say nothing about cf-minter. Project-specific
# tracking (scope, state, brief, decisions) IS tracked.
.agent/REPORTS/ARCHIVED/*-button-up.md
